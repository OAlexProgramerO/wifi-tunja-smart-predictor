RANDOM_SEED=42
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the APIs. Defaults to local Streamlit origins.
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Optional loopback host ports for Docker Compose; container ports remain fixed.
MAIN_API_HOST_PORT=8000
ASSISTANT_API_HOST_PORT=8001
DASHBOARD_HOST_PORT=8501
# Optional server-side dashboard URLs. Compose defaults to its service DNS names.
# Uncomment only for container-specific routing; host-local defaults remain 127.0.0.1.
# MAIN_API_URL=http://main-api:8000
# ASSISTANT_API_URL=http://assistant-api:8001
